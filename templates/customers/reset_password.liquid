<section class="section">
  <div class="narrow auth" data-reveal>
    <h1 class="h2">Reset your password</h1>
    {%- form 'reset_customer_password', class: 'auth__form' -%}
      {{ form.errors | default_errors }}
      <input class="input" type="password" name="customer[password]" placeholder="New password" autocomplete="new-password" aria-label="New password">
      <input class="input" type="password" name="customer[password_confirmation]" placeholder="Confirm password" autocomplete="new-password" aria-label="Confirm password">
      <button class="btn btn--ink" type="submit">Reset password</button>
    {%- endform -%}
  </div>
</section>
