<section class="section">
  <div class="narrow auth" data-reveal>
    <h1 class="h2">Create account</h1>
    {%- form 'create_customer', class: 'auth__form' -%}
      {{ form.errors | default_errors }}
      <input class="input" type="text" name="customer[first_name]" placeholder="First name" autocomplete="given-name" aria-label="First name">
      <input class="input" type="text" name="customer[last_name]" placeholder="Last name" autocomplete="family-name" aria-label="Last name">
      <input class="input" type="email" name="customer[email]" placeholder="Email" autocomplete="email" aria-label="Email" required>
      <input class="input" type="password" name="customer[password]" placeholder="Password" autocomplete="new-password" aria-label="Password" required>
      <label class="auth__row" style="font-family: var(--f-ui); font-size: 14px"><input type="checkbox" name="customer[accepts_marketing]" value="true" checked> Send me treats, bandanas, and shelter updates</label>
      <button class="btn btn--ink" type="submit">Create account</button>
      <a class="link-btn" href="{{ routes.account_login_url }}">I already have an account</a>
    {%- endform -%}
  </div>
</section>
