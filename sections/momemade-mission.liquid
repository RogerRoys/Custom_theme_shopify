{% comment %}
  Momemade "Rescue is at the heart of MOMEMADE." — photo collage with a
  donation stat card on the left, mission copy and CTA on the right.
{% endcomment %}

<section class="momemade-mission">
  <div class="momemade-mission__inner">
    <div class="momemade-mission__media">
      <div class="momemade-mission__image momemade-mission__image--main">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag: widths: '550, 820, 1100', sizes: '(max-width: 749px) 100vw, 45vw', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'momemade-mission__placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.stat_number != blank -%}
        <div class="momemade-mission__stat">
          <span class="momemade-mission__stat-number">{{ section.settings.stat_number }}</span>
          <span class="momemade-mission__stat-label">{{ section.settings.stat_label }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.credit_text != blank -%}
        <div class="momemade-mission__credit">
          <span>{{ section.settings.credit_text }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="momemade-mission__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="momemade-mission__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="momemade-mission__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="momemade-mission__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="momemade-mission__button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .momemade-mission {
    background: #f5dfe2;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding: 80px;
  }

  .momemade-mission__inner {
    max-width: 1352px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .momemade-mission__media {
    position: relative;
  }

  .momemade-mission__image--main {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #ede8df;
  }

  .momemade-mission__image--main img,
  .momemade-mission__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .momemade-mission__stat {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.4);
    padding: 24px;
    width: min(85%, 319px);
    min-height: 324px;
    justify-content: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 32px;
  }

  .momemade-mission__credit {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 40px 24px 16px;
    background: linear-gradient(0deg, rgba(9, 11, 0, 0.75) 0%, rgba(9, 11, 0, 0) 100%);
    display: flex;
    justify-content: center;
  }

  .momemade-mission__credit span {
    font-family: var(--momemade-font-secondary, 'Jost', 'Century Gothic', sans-serif);
    font-weight: 400;
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #ffffff;
  }

  .momemade-mission__stat-number {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(96px, 8.5vw, 128px);
    line-height: 1;
    letter-spacing: -1px;
    color: #84c99a;
  }

  .momemade-mission__stat-label {
    font-family: var(--momemade-font-secondary, 'Jost', 'Century Gothic', sans-serif);
    font-weight: 400;
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #ffffff;
  }

  .momemade-mission__eyebrow {
    font-family: var(--momemade-font-secondary, 'Jost', 'Century Gothic', sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #090b00;
    margin: 0 0 16px;
  }

  .momemade-mission__heading {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(36px, 4.2vw, 64px);
    line-height: 1;
    letter-spacing: -1px;
    color: #090b00;
    margin: 0 0 20px;
    max-width: 560px;
  }

  .momemade-mission__text {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 16px;
    line-height: 28px;
    color: #090b00;
    max-width: 460px;
    margin: 0 0 32px;
  }

  .momemade-mission__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 24px 32px;
    background: #d49ed7;
    color: #090b00;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .momemade-mission__button:hover {
    opacity: 0.85;
  }

  /* Tablet/mobile: text above image, single column */
  @media screen and (max-width: 989px) {
    .momemade-mission {
      padding: 72px 40px;
    }

    .momemade-mission__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .momemade-mission__content {
      order: 1;
    }

    .momemade-mission__media {
      order: 2;
    }

    .momemade-mission__heading {
      font-size: 56px;
      line-height: 60px;
      max-width: none;
    }

    .momemade-mission__eyebrow {
      font-size: 11px;
    }

    .momemade-mission__text {
      max-width: none;
    }

    .momemade-mission__button {
      padding: 24px 32px;
      font-size: 16px;
    }

    .momemade-mission__image--secondary {
      right: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .momemade-mission {
      padding: 56px 20px;
    }

    .momemade-mission__inner {
      gap: 20px;
    }

    .momemade-mission__heading {
      font-size: 48px;
      line-height: 56px;
    }

    .momemade-mission__image--main {
      aspect-ratio: auto;
      height: 445px;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Momemade mission",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat number",
      "default": "96"
    },
    {
      "type": "text",
      "id": "credit_text",
      "label": "Photo credit",
      "default": "@ulstercountycanines · Saugerties, NY"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Stat label",
      "default": "Bags donated · Every one personally delivered by Michele"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Mission"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Rescue is at the heart of MOMEMADE."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Rescue isn’t a campaign for us — it’s who we are. We choose to support Ulster County Canines because they’re small and mighty, just like us. They operate on donations alone and frequently run out of treats."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "READ OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Momemade mission"
    }
  ]
}
{% endschema %}
