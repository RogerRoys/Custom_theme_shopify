{% comment %}
  Momemade "Rescue is at the heart of MOMEMADE." — photo collage with a
  donation stat card on the left, mission copy and CTA on the right.
{% endcomment %}

<section class="momemade-mission">
  <div class="momemade-mission__inner">
    <div class="momemade-mission__media">
      <div class="momemade-mission__image momemade-mission__image--main">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1100 | image_tag: widths: '550, 820, 1100', sizes: '(max-width: 749px) 100vw, 45vw', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'momemade-mission__placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.image_2 != blank -%}
        <div class="momemade-mission__image momemade-mission__image--secondary">
          {{ section.settings.image_2 | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '20vw', alt: section.settings.image_2.alt }}
        </div>
      {%- endif -%}
      {%- if section.settings.stat_number != blank -%}
        <div class="momemade-mission__stat">
          <span class="momemade-mission__stat-number">{{ section.settings.stat_number }}</span>
          <span class="momemade-mission__stat-label">{{ section.settings.stat_label }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="momemade-mission__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="momemade-mission__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="momemade-mission__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="momemade-mission__text">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="momemade-mission__button">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .momemade-mission {
    background: #f5dfe2;
    padding: 80px 40px;
  }

  .momemade-mission__inner {
    max-width: 1174px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .momemade-mission__media {
    position: relative;
  }

  .momemade-mission__image--main {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #ede8df;
  }

  .momemade-mission__image--main img,
  .momemade-mission__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .momemade-mission__image--secondary {
    position: absolute;
    right: -24px;
    bottom: -24px;
    width: 45%;
    border-radius: 16px;
    overflow: hidden;
    border: 6px solid #f5dfe2;
  }

  .momemade-mission__image--secondary img {
    width: 100%;
    display: block;
  }

  .momemade-mission__stat {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: #ffffff;
    padding: 28px 24px;
    width: min(60%, 240px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .momemade-mission__stat-number {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(40px, 3.5vw, 56px);
    line-height: 1;
    letter-spacing: -1px;
    color: #84c99a;
  }

  .momemade-mission__stat-label {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 10px;
    line-height: 15px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #090b00;
  }

  .momemade-mission__eyebrow {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #090b00;
    margin: 0 0 16px;
  }

  .momemade-mission__heading {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(36px, 3.5vw, 52px);
    line-height: 1.05;
    letter-spacing: -1px;
    color: #090b00;
    margin: 0 0 20px;
    max-width: 460px;
  }

  .momemade-mission__text {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 16px;
    line-height: 28px;
    color: #090b00;
    max-width: 460px;
    margin: 0 0 32px;
  }

  .momemade-mission__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background: #d49ed7;
    color: #090b00;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .momemade-mission__button:hover {
    opacity: 0.85;
  }

  @media screen and (max-width: 989px) {
    .momemade-mission {
      padding: 56px 20px;
    }

    .momemade-mission__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .momemade-mission__image--secondary {
      right: 0;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Momemade mission",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Secondary image (overlap)"
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat number",
      "default": "96"
    },
    {
      "type": "text",
      "id": "stat_label",
      "label": "Stat label",
      "default": "Bags donated · Every one personally delivered by Michele"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Mission"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Rescue is at the heart of MOMEMADE."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Rescue isn’t a campaign for us — it’s who we are. We chose to support Ulster County Canines because they’re small and mighty, just like us. They operate on donations alone and frequently run out of treats."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "READ OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Momemade mission"
    }
  ]
}
{% endschema %}
