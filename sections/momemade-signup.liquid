{% comment %}
  Momemade "Stay. Stay. Stay in touch." — dark email signup with donation
  stats. Every N signups donates a bag to the shelter; stat tiles are
  blocks so the numbers can be updated from the theme editor.
{% endcomment %}

<section class="momemade-signup">
  <div class="momemade-signup__inner">
    <div class="momemade-signup__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="momemade-signup__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="momemade-signup__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="momemade-signup__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'momemade-signup-form', class: 'momemade-signup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="momemade-signup__success">{{ section.settings.success_text }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <p class="momemade-signup__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <div class="momemade-signup__field">
            <label class="visually-hidden" for="momemade-signup-email">Email</label>
            <input
              type="email"
              id="momemade-signup-email"
              name="contact[email]"
              placeholder="{{ section.settings.placeholder }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="momemade-signup__button">{{ section.settings.button_label }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.note != blank -%}
        <p class="momemade-signup__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="momemade-signup__stats">
        {%- for block in section.blocks -%}
          <div class="momemade-signup__stat" {{ block.shopify_attributes }}>
            <span class="momemade-signup__stat-number">{{ block.settings.number }}</span>
            <span class="momemade-signup__stat-label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  .momemade-signup {
    background: #090b00;
    padding: 96px 40px;
  }

  .momemade-signup__inner {
    max-width: 1174px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .momemade-signup__eyebrow {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #a0dbb3;
    margin: 0 0 16px;
  }

  .momemade-signup__heading {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(36px, 3.5vw, 56px);
    line-height: 1.05;
    letter-spacing: -1px;
    color: #f5dbdf;
    margin: 0 0 20px;
    max-width: 420px;
  }

  .momemade-signup__text {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 16px;
    line-height: 28px;
    color: rgba(245,219,223,0.8);
    max-width: 460px;
    margin: 0 0 28px;
  }

  .momemade-signup__field {
    display: flex;
    gap: 10px;
    max-width: 460px;
  }

  .momemade-signup__field input {
    flex: 1;
    min-width: 0;
    padding: 14px 16px;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 15px;
    color: #090b00;
    background: #ffffff;
    border: 0;
    border-radius: 0;
  }

  .momemade-signup__field input:focus {
    outline: 2px solid #d49ed7;
  }

  .momemade-signup__button {
    padding: 14px 32px;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #090b00;
    background: #d49ed7;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .momemade-signup__button:hover {
    opacity: 0.85;
  }

  .momemade-signup__note {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 13px;
    line-height: 20px;
    color: rgba(245,219,223,0.6);
    margin: 16px 0 0;
  }

  .momemade-signup__success {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 16px;
    color: #a0dbb3;
    margin: 0;
  }

  .momemade-signup__error {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 14px;
    color: #d49ed7;
    margin: 0 0 12px;
  }

  .momemade-signup__stats {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 24px 8px;
  }

  .momemade-signup__stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 16px 20px;
    position: relative;
  }

  .momemade-signup__stat + .momemade-signup__stat::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .momemade-signup__stat-number {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(40px, 3.5vw, 56px);
    line-height: 1;
    letter-spacing: -1px;
    color: #a0dbb3;
  }

  .momemade-signup__stat-label {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 11px;
    line-height: 16px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: rgba(245,219,223,0.7);
    max-width: 140px;
  }

  @media screen and (max-width: 989px) {
    .momemade-signup {
      padding: 64px 20px;
    }

    .momemade-signup__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .momemade-signup__field {
      flex-direction: column;
      max-width: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Momemade signup",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Join the Momemade community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay. Stay. Stay in touch."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every 20 email signups, we donate a bag of biscuits to Ulster County Canines. Join and make every signup count."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "JOIN"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "No spam. Just treats, bandanas, and the occasional shelter update."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thanks for joining! Every signup counts. 🐾"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "47"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Signups so far"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Momemade signup",
      "blocks": [
        { "type": "stat", "settings": { "number": "47", "label": "Signups so far" } },
        { "type": "stat", "settings": { "number": "2", "label": "Bags donated" } },
        { "type": "stat", "settings": { "number": "13", "label": "Until next bag" } }
      ]
    }
  ]
}
{% endschema %}
