<div class="page-section">
  <div class="page-width--narrow" style="max-width: 640px;">
    <div class="section-heading">
      <h1 class="section-heading__title">Addresses</h1>
      <p class="section-heading__subtitle"><a href="{{ routes.account_url }}">Back to account</a></p>
    </div>

    <div style="margin-top: 40px;">
      <h2 style="font-size: 24px;">Add a new address</h2>
      {%- form 'customer_address', customer.new_address -%}
        <div class="field">
          <label for="address-first-name">First name</label>
          <input type="text" id="address-first-name" name="address[first_name]" autocomplete="given-name">
        </div>
        <div class="field">
          <label for="address-last-name">Last name</label>
          <input type="text" id="address-last-name" name="address[last_name]" autocomplete="family-name">
        </div>
        <div class="field">
          <label for="address-address1">Address</label>
          <input type="text" id="address-address1" name="address[address1]" autocomplete="address-line1">
        </div>
        <div class="field">
          <label for="address-address2">Apartment, suite, etc.</label>
          <input type="text" id="address-address2" name="address[address2]" autocomplete="address-line2">
        </div>
        <div class="field">
          <label for="address-city">City</label>
          <input type="text" id="address-city" name="address[city]" autocomplete="address-level2">
        </div>
        <div class="field">
          <label for="address-country">Country/region</label>
          <select id="address-country" name="address[country]" data-default="{{ customer.new_address.country }}">
            {{ all_country_option_tags }}
          </select>
        </div>
        <div class="field">
          <label for="address-province">State/province</label>
          <input type="text" id="address-province" name="address[province]" autocomplete="address-level1">
        </div>
        <div class="field">
          <label for="address-zip">Postal/ZIP code</label>
          <input type="text" id="address-zip" name="address[zip]" autocomplete="postal-code">
        </div>
        <div class="field">
          <label for="address-phone">Phone</label>
          <input type="tel" id="address-phone" name="address[phone]" autocomplete="tel">
        </div>
        <button type="submit" class="btn btn--dark btn--full">Add address</button>
      {%- endform -%}
    </div>

    <div style="margin-top: 48px;">
      <h2 style="font-size: 24px;">Saved addresses ({{ customer.addresses_count }})</h2>
      {%- paginate customer.addresses by 6 -%}
        {%- for address in customer.addresses -%}
          <div style="background: var(--color-cream); border-radius: 16px; padding: 20px; margin-bottom: 12px;">
            {%- if address == customer.default_address -%}
              <p class="section-heading__eyebrow" style="text-align:left;">Default</p>
            {%- endif -%}
            {{ address | format_address }}
            <form method="post" action="{{ address.url }}" onsubmit="return confirm('Delete this address?');">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="btn btn--outline">Delete</button>
            </form>
          </div>
        {%- endfor -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Addresses",
  "settings": []
}
{% endschema %}
