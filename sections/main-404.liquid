<section class="section">
  <div class="narrow center" data-reveal>
    <span class="eyebrow">404</span>
    <h1 class="h2">{{ section.settings.heading | escape }}</h1>
    <p class="body">{{ section.settings.text | escape }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">Shop all</a>
  </div>
</section>
{% schema %}
{"name":"404","settings":[{"type":"text","id":"heading","label":"Heading","default":"This page went for a walk."},{"type":"text","id":"text","label":"Text","default":"We couldn’t find what you were looking for."}]}
{% endschema %}
