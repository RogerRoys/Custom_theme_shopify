<footer class="footer">
  <div class="footer__top">
    <a href="{{ routes.root_url }}" class="footer__logo" data-reveal aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 800 | image_tag: alt: shop.name, loading: 'lazy' }}
      {%- else -%}
        <img src="{{ 'momemade-logo-footer.svg' | asset_url }}" alt="{{ shop.name }} — Dog goods, mom approved" width="356" height="77" loading="lazy">
      {%- endif -%}
    </a>
    {%- if section.settings.show_newsletter -%}
      <div class="footer__form" data-reveal style="--d: 120ms">
        <div class="footer__head">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          <span class="footer__h">{{ section.settings.heading | escape }}</span>
        </div>
        {%- assign fid = 'Footer-' | append: section.id -%}
        {% render 'newsletter-form', form_id: fid %}
      </div>
    {%- endif -%}
  </div>
  <div class="footer__bottom">
    <div class="footer__rule"></div>
    <ul class="footer__links">
      {%- for link in section.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
    </ul>
    {%- if section.settings.show_copyright -%}<p class="footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ powered_by_link }}</p>{%- endif -%}
  </div>
</footer>
{% schema %}
{"name":"Footer","class":"section-footer","enabled_on":{"groups":["footer"]},"settings":[
{"type":"image_picker","id":"logo","label":"Footer logo","info":"Leave empty to use the built-in mint MOMEMADE logo"},
{"type":"checkbox","id":"show_newsletter","label":"Show newsletter","default":true},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Stay in touch"},
{"type":"text","id":"heading","label":"Heading","default":"Stay. Stay. Stay in touch."},
{"type":"link_list","id":"menu","label":"Menu","default":"footer"},
{"type":"checkbox","id":"show_copyright","label":"Show copyright","default":false}]}
{% endschema %}
