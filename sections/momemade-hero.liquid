{% comment %}
  Momemade hero — full-bleed photo slider (redesign, Figma 538:4010).
  Each slide is a block: full-viewport photo (optionally split into a
  left/right pair), dark top + bottom scrims, centered content. Fields
  left blank are hidden, so slide 2 can be a single headline over the
  photo. Pager (counter + progress + round arrows) shows when there is
  more than one slide. The navbar overlays this section on the homepage
  (see momemade-header.liquid).
{% endcomment %}

<section class="momemade-hero" id="momemade-hero-{{ section.id }}">
  <div class="momemade-hero__slides">
    {%- for block in section.blocks -%}
      <div
        class="momemade-hero__slide{% if forloop.first %} is-active{% endif %} momemade-hero__slide--{{ block.settings.content_position }}"
        data-hero-slide
        {{ block.shopify_attributes }}
      >
        <div class="momemade-hero__bg" aria-hidden="true">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 2200
              | image_tag: class: 'momemade-hero__bg-image', widths: '800, 1400, 2200', sizes: '100vw', alt: block.settings.image.alt, preload: forloop.first
            }}
          {%- else -%}
            <div class="momemade-hero__bg-placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'momemade-hero__placeholder-svg' }}
            </div>
          {%- endif -%}
          {%- if block.settings.image_2 != blank -%}
            {{
              block.settings.image_2
              | image_url: width: 1200
              | image_tag: class: 'momemade-hero__bg-image momemade-hero__bg-image--right', widths: '600, 900, 1200', sizes: '50vw', alt: block.settings.image_2.alt
            }}
          {%- endif -%}
          <div class="momemade-hero__scrim"></div>
        </div>

        <div class="momemade-hero__content">
          {%- if block.settings.eyebrow != blank -%}
            <p class="momemade-hero__eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="momemade-hero__heading">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <div class="momemade-hero__subheading">{{ block.settings.subheading }}</div>
          {%- endif -%}
          {%- if block.settings.button1_label != blank or block.settings.button2_label != blank -%}
            <div class="momemade-hero__buttons">
              {%- if block.settings.button1_label != blank -%}
                <a href="{{ block.settings.button1_link | default: '#' }}" class="momemade-hero__btn momemade-hero__btn--pink">{{ block.settings.button1_label }}</a>
              {%- endif -%}
              {%- if block.settings.button2_label != blank -%}
                <a href="{{ block.settings.button2_link | default: '#' }}" class="momemade-hero__btn momemade-hero__btn--mint">{{ block.settings.button2_label }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if block.settings.rating_text != blank -%}
            <p class="momemade-hero__rating">
              <span class="momemade-hero__rating-stars" aria-hidden="true">{{ block.settings.rating_stars }}</span>
              {{ block.settings.rating_text }}
            </p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="momemade-hero__pager">
      <div class="momemade-hero__pager-info">
        <span class="momemade-hero__pager-counter" data-hero-counter>1/{{ section.blocks.size }}</span>
        <span class="momemade-hero__progress"><span class="momemade-hero__progress-fill" data-hero-progress></span></span>
      </div>
      <button type="button" class="momemade-hero__arrow" data-hero-prev aria-label="Previous slide">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14.5 5.5 8 12l6.5 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" class="momemade-hero__arrow" data-hero-next aria-label="Next slide">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M9.5 5.5 16 12l-6.5 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('momemade-hero-{{ section.id }}');
    if (!root || root.dataset.heroInit) return;
    root.dataset.heroInit = '1';

    var slides = root.querySelectorAll('[data-hero-slide]');
    var counter = root.querySelector('[data-hero-counter]');
    var progress = root.querySelector('[data-hero-progress]');
    var prev = root.querySelector('[data-hero-prev]');
    var next = root.querySelector('[data-hero-next]');
    if (slides.length < 2 || !prev || !next) {
      if (progress) progress.style.width = '100%';
      return;
    }

    var current = 0;

    function show(index) {
      current = (index + slides.length) % slides.length;
      for (var i = 0; i < slides.length; i++) {
        slides[i].classList.toggle('is-active', i === current);
      }
      if (counter) counter.textContent = (current + 1) + '/' + slides.length;
      if (progress) progress.style.width = (((current + 1) / slides.length) * 100) + '%';
    }

    prev.addEventListener('click', function () { show(current - 1); });
    next.addEventListener('click', function () { show(current + 1); });
    show(0);
  })();
</script>

{% style %}
  .momemade-hero {
    position: relative;
    background: #090b00;
    min-height: calc(100vh - 34px);
    min-height: calc(100svh - 34px);
    overflow: hidden;
  }

  .momemade-hero__slides {
    position: absolute;
    inset: 0;
  }

  .momemade-hero__slide {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease, visibility 0.6s ease;
  }

  .momemade-hero__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .momemade-hero__slide--bottom {
    justify-content: flex-end;
  }

  .momemade-hero__bg {
    position: absolute;
    inset: 0;
    display: flex;
  }

  .momemade-hero__bg-image,
  .momemade-hero__bg-placeholder,
  .momemade-hero__placeholder-svg {
    flex: 1 1 0;
    width: 100%;
    height: 100%;
    min-width: 0;
    object-fit: cover;
    display: block;
  }

  .momemade-hero__bg-placeholder {
    background: #1a1d10;
  }

  /* Dark gradients: header legibility up top, text legibility below */
  .momemade-hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(9, 11, 0, 0.75) 0%, rgba(9, 11, 0, 0) 164px),
      linear-gradient(0deg, rgba(9, 11, 0, 0.82) 0%, rgba(9, 11, 0, 0.35) 45%, rgba(9, 11, 0, 0) 75%);
  }

  .momemade-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    padding: 172px 80px 80px;
    max-width: 1340px;
    margin: 0 auto;
    width: 100%;
  }

  .momemade-hero__eyebrow {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    text-transform: uppercase;
    color: #f5dbdf;
    margin: 0;
  }

  .momemade-hero__heading {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(40px, 8.6vw, 80px);
    line-height: 1;
    letter-spacing: -1px;
    color: #f5dbdf;
    max-width: 1150px;
    margin: 0;
  }

  /* Highlighted word: dark on a pink chip (Figma "just" treatment).
     Side bleed via box-shadow so the heading wraps as if unhighlighted */
  .momemade-hero__heading em {
    font-style: italic;
    font-weight: 700;
    color: #090b00;
    background: #d49ed7;
    box-shadow: 0.12em 0 0 #d49ed7, -0.12em 0 0 #d49ed7;
    white-space: nowrap;
  }

  .momemade-hero__subheading {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 400;
    font-size: clamp(16px, 1.9vw, 28px);
    line-height: 1.25;
    letter-spacing: -0.5px;
    color: rgba(245, 219, 223, 0.85);
    max-width: 1340px;
    margin: 0;
  }

  .momemade-hero__subheading p {
    margin: 0;
  }

  .momemade-hero__subheading strong {
    font-weight: 700;
  }

  .momemade-hero__buttons {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .momemade-hero__btn {
    flex: 0 0 auto;
    width: 220px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 24px 10px;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    color: #090b00;
    transition: opacity 0.15s ease;
  }

  .momemade-hero__btn:hover {
    opacity: 0.85;
  }

  .momemade-hero__btn--pink {
    background: #d49ed7;
  }

  .momemade-hero__btn--mint {
    background: #a0dbb3;
  }

  .momemade-hero__rating {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 24px;
    line-height: 28px;
    color: #d49ed7;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .momemade-hero__rating-stars {
    font-family: var(--momemade-font-secondary, 'Jost', 'Century Gothic', sans-serif);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 2.4px;
  }

  .momemade-hero__pager {
    position: absolute;
    right: 53px;
    bottom: 70px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .momemade-hero__pager-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-right: 44px;
  }

  .momemade-hero__pager-counter {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 14px;
    line-height: 14px;
    color: rgba(245, 219, 223, 0.8);
  }

  .momemade-hero__progress {
    display: block;
    width: 65px;
    height: 4px;
    background: rgba(212, 158, 215, 0.2);
  }

  .momemade-hero__progress-fill {
    display: block;
    width: 50%;
    height: 100%;
    background: #d49ed7;
    transition: width 0.3s ease;
  }

  .momemade-hero__arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #ffffff;
    color: #090b00;
    border: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .momemade-hero__arrow:hover {
    opacity: 0.85;
  }

  /* Tablet: content sits lower, smaller buttons */
  @media screen and (max-width: 989px) {
    .momemade-hero {
      min-height: calc(100vh - 34px);
      min-height: calc(100svh - 34px);
    }

    .momemade-hero__slide {
      justify-content: flex-end;
    }

    .momemade-hero__content {
      padding: 140px 40px 110px;
      gap: 20px;
    }

    .momemade-hero__eyebrow {
      font-size: 14px;
    }

    .momemade-hero__subheading {
      line-height: 1.4;
    }

    .momemade-hero__btn {
      width: 180px;
      padding: 16px 10px;
      font-size: 14px;
    }

    .momemade-hero__rating {
      font-size: 16px;
      line-height: 24px;
      gap: 10px;
    }

    .momemade-hero__rating-stars {
      font-size: 15px;
      letter-spacing: 1.8px;
    }

    .momemade-hero__pager {
      right: 24px;
      bottom: 32px;
    }

    .momemade-hero__pager-info {
      margin-right: 16px;
    }
  }

  /* Mobile: left-aligned text, buttons split the row */
  @media screen and (max-width: 749px) {
    .momemade-hero {
      min-height: calc(100vh - 32px);
      min-height: calc(100svh - 32px);
    }

    .momemade-hero__content {
      align-items: flex-start;
      text-align: left;
      padding: 120px 20px 96px;
      gap: 16px;
    }

    .momemade-hero__eyebrow {
      font-size: 12px;
    }

    .momemade-hero__subheading {
      max-width: 362px;
    }

    .momemade-hero__buttons {
      width: 100%;
      justify-content: flex-start;
    }

    .momemade-hero__btn {
      flex: 1 1 0;
      width: auto;
      max-width: 220px;
      padding: 16px 8px;
    }

    .momemade-hero__rating {
      font-size: 13px;
      line-height: 20px;
      justify-content: flex-start;
      gap: 8px;
    }

    .momemade-hero__rating-stars {
      font-size: 12px;
      letter-spacing: 1.5px;
    }

    .momemade-hero__pager {
      right: 16px;
      bottom: 20px;
      gap: 8px;
    }

    .momemade-hero__arrow {
      width: 32px;
      height: 32px;
    }

    .momemade-hero__arrow svg {
      width: 16px;
      height: 16px;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Momemade hero",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Right-half photo (optional)",
          "info": "For a split background of two photos side by side"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "info": "Italic text gets the pink highlight chip",
          "default": "You can make these yourself. We just did it for you."
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position (desktop)",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "center"
        },
        {
          "type": "header",
          "content": "Buttons"
        },
        {
          "type": "text",
          "id": "button1_label",
          "label": "Pink button label"
        },
        {
          "type": "url",
          "id": "button1_link",
          "label": "Pink button link"
        },
        {
          "type": "text",
          "id": "button2_label",
          "label": "Mint button label"
        },
        {
          "type": "url",
          "id": "button2_link",
          "label": "Mint button link"
        },
        {
          "type": "header",
          "content": "Trust line"
        },
        {
          "type": "text",
          "id": "rating_stars",
          "label": "Stars",
          "default": "★★★★★"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Momemade hero",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "eyebrow": "Homemade Biscuits & Hand-Sewn Bandanas",
            "heading": "You can make these yourself. We just did it for you.",
            "subheading": "<p>Kitchen-baked, plant-based, limited ingredient biscuits — <strong>safe for dogs with allergies and sensitive stomachs</strong>. Reversible bandanas hand-sewn from surplus, thrifted, and upcycled fabrics.</p>",
            "button1_label": "SHOP BISCUITS",
            "button2_label": "SHOP BANDANAS",
            "rating_text": "Carried in Hudson Valley ·  NYC ·  20+ stores"
          }
        },
        {
          "type": "slide",
          "settings": {
            "heading": "“It’s not <em>just</em> a dog. They’re family.”",
            "content_position": "bottom"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
