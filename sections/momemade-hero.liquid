<section class="momemade-hero">
  <div class="momemade-hero__inner">
    <div class="momemade-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="momemade-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <div class="momemade-hero__heading-wrap">
        <h1 class="momemade-hero__heading">{{ section.settings.heading }}</h1>
        {%- if section.settings.show_sparkle -%}
          <span class="momemade-hero__sparkle">{% render 'momemade-icons', name: 'sparkle' %}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="momemade-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="momemade-hero__buttons">
          {%- for block in section.blocks -%}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="momemade-hero__btn momemade-hero__btn--{{ block.settings.style }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.rating_text != blank -%}
        <p class="momemade-hero__rating">
          <span class="momemade-hero__rating-stars" aria-hidden="true">{{ section.settings.rating_stars }}</span>
          {{ section.settings.rating_text }}
        </p>
      {%- endif -%}
    </div>

    <div class="momemade-hero__media-wrap">
      <div class="momemade-hero__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: class: 'momemade-hero__image', widths: '760, 1080, 1600', sizes: '(max-width: 749px) 100vw, 50vw', alt: section.settings.image.alt
          }}
        {%- else -%}
          <div class="momemade-hero__image-placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'momemade-hero__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_badge -%}
        <div class="momemade-hero__badge" aria-hidden="true">
          {% render 'momemade-icons', name: 'badge-flower' %}
          <span class="momemade-hero__badge-text">{{ section.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.show_paw -%}
        <span class="momemade-hero__paw" aria-hidden="true">{% render 'momemade-icons', name: 'paw' %}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .momemade-hero {
    background: #090b00;
    padding: 24px;
  }

  .momemade-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .momemade-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 66px 56px;
    position: relative;
  }

  .momemade-hero__eyebrow {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    color: #d49ed7;
    margin: 0 0 20px;
  }

  .momemade-hero__heading-wrap {
    position: relative;
    max-width: 560px;
  }

  .momemade-hero__heading {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(40px, 4.2vw, 64px);
    line-height: 1;
    letter-spacing: -1px;
    color: #f5dbdf;
    margin: 0 0 20px;
  }

  .momemade-hero__sparkle {
    position: absolute;
    top: -25px;
    right: -35px;
    width: 85px;
    height: 84px;
    color: #a0dbb3;
  }

  .momemade-hero__sparkle svg {
    width: 100%;
    height: 100%;
  }

  .momemade-hero__subheading {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 400;
    font-size: 16px;
    line-height: 28px;
    color: rgba(245,219,223,0.8);
    max-width: 546px;
    margin: 0 0 64px;
  }

  .momemade-hero__buttons {
    display: flex;
    gap: 10px;
    width: 100%;
    max-width: 580px;
  }

  .momemade-hero__btn {
    flex: 1 0 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 24px 10px;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .momemade-hero__btn:hover {
    opacity: 0.85;
  }

  .momemade-hero__btn--pink {
    background: #d49ed7;
    color: #090b00;
  }

  .momemade-hero__btn--mint {
    background: #a0dbb3;
    color: #090b00;
  }

  .momemade-hero__btn--outline {
    background: transparent;
    border: 1px solid #ffffff;
    color: #ffffff;
  }

  .momemade-hero__rating {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 18px;
    line-height: 28px;
    color: #d49ed7;
    margin: 16px 0 0;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .momemade-hero__rating-stars {
    font-weight: 700;
    font-size: 16.8px;
    color: #d49ed7;
    letter-spacing: 2.4px;
  }

  .momemade-hero__media-wrap {
    position: relative;
  }

  .momemade-hero__media {
    overflow: hidden;
    height: 100%;
    min-height: 560px;
  }

  .momemade-hero__image,
  .momemade-hero__image-placeholder,
  .momemade-hero__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .momemade-hero__image-placeholder {
    background: #ede8df;
  }

  .momemade-hero__badge {
    position: absolute;
    top: 28px;
    left: 36px;
    width: 154px;
    height: 154px;
    color: #d49ed7;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: momemade-badge-spin 24s linear infinite;
  }

  .momemade-hero__badge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.92;
  }

  .momemade-hero__badge-text {
    position: relative;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 20px;
    line-height: 20px;
    letter-spacing: -1px;
    text-align: center;
    text-transform: uppercase;
    color: #ffffff;
    max-width: 110px;
  }

  @keyframes momemade-badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .momemade-hero__badge-text {
    animation: momemade-badge-spin 24s linear infinite reverse;
  }

  .momemade-hero__paw {
    position: absolute;
    bottom: -46px;
    left: -100px;
    width: 198px;
    height: 207px;
    color: #a0dbb3;
    pointer-events: none;
  }

  .momemade-hero__paw svg {
    width: 100%;
    height: 100%;
  }

  /* Tablet (834 spec): stacked & centered, fixed-width button row, image below */
  @media screen and (max-width: 989px) {
    .momemade-hero {
      padding: 0;
    }

    .momemade-hero__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .momemade-hero__content {
      order: 1;
      align-items: center;
      text-align: center;
      padding: 48px 40px 0;
    }

    .momemade-hero__heading-wrap {
      max-width: 603px;
    }

    .momemade-hero__eyebrow {
      font-size: 12px;
    }

    .momemade-hero__heading {
      font-size: 56px;
      line-height: 60px;
    }

    .momemade-hero__subheading {
      margin-bottom: 32px;
    }

    .momemade-hero__buttons {
      justify-content: center;
      max-width: none;
      width: auto;
    }

    .momemade-hero__btn {
      flex: 0 0 auto;
      width: 180px;
      padding: 16px 10px;
      font-size: 14px;
    }

    .momemade-hero__rating {
      justify-content: center;
      font-size: 11px;
      gap: 6px;
    }

    .momemade-hero__rating-stars {
      font-size: 12px;
      letter-spacing: 1.5px;
    }

    .momemade-hero__media-wrap {
      order: 2;
    }

    .momemade-hero__media {
      min-height: 480px;
    }

    .momemade-hero__sparkle {
      top: -22px;
      right: 0;
      width: 64px;
      height: 63px;
    }

    .momemade-hero__paw {
      left: auto;
      right: -40px;
      bottom: -40px;
      width: 140px;
      height: 146px;
    }

    .momemade-hero__badge {
      width: 110px;
      height: 110px;
      top: 16px;
      left: 16px;
    }

    .momemade-hero__badge-text {
      font-size: 14px;
      line-height: 14px;
      max-width: 80px;
    }
  }

  /* Mobile (402 spec): left-aligned, two solid buttons in a row + ghost full width */
  @media screen and (max-width: 749px) {
    .momemade-hero__content {
      align-items: flex-start;
      text-align: left;
      padding: 56px 20px 0;
    }

    .momemade-hero__eyebrow {
      font-size: 10px;
    }

    .momemade-hero__heading {
      font-size: 48px;
      line-height: 56px;
    }

    .momemade-hero__buttons {
      flex-wrap: wrap;
      width: 100%;
    }

    .momemade-hero__btn {
      flex: 1 1 0;
      width: auto;
    }

    .momemade-hero__btn--outline {
      flex: 1 1 100%;
    }

    .momemade-hero__rating {
      width: 100%;
      justify-content: center;
    }

    .momemade-hero__media {
      min-height: 380px;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Momemade hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DOG GOODS. MOM APPROVED. · HUDSON VALLEY, NY"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "“If I wouldn't give it to my own dog, I don't make it”"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Plant-based biscuits baked in our kitchen. Bandanas sewn one at a time from reclaimed fabrics. Simple ingredients for what goes in your dog. Thoughtful materials for what goes on your dog."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Decorations"
    },
    {
      "type": "checkbox",
      "id": "show_sparkle",
      "label": "Show sparkle doodle",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paw",
      "label": "Show paw print",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Approved by vet"
    },
    {
      "type": "header",
      "content": "Rating line"
    },
    {
      "type": "text",
      "id": "rating_stars",
      "label": "Stars",
      "default": "★★★★★"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Text",
      "default": "Carried in 20+ stores across the Hudson Valley"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "SHOP BISCUITS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "pink",
              "label": "Pink"
            },
            {
              "value": "mint",
              "label": "Mint"
            },
            {
              "value": "outline",
              "label": "Outline"
            }
          ],
          "default": "pink"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Momemade hero",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "SHOP BISCUITS",
            "style": "pink"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "SHOP BANDANAS",
            "style": "mint"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "FIND YOUR BISCUIT",
            "style": "outline"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
