<section class="section reviews" id="reviews" data-inview>
  <div class="reviews__head" data-reveal>
    <div class="reviews__rating">
      <span class="stars">{%- for i in (1..5) -%}<span style="--d: {{ forloop.index0 | times: 90 }}ms"><svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="M7.153 3.408C8.42 1.136 9.053 0 10 0s1.58 1.136 2.847 3.408l.328.588c.36.646.539.969.82 1.182.281.213.63.292 1.329.45l.636.144c2.46.557 3.69.835 3.983 1.776.292.941-.546 1.921-2.223 3.882l-.434.507c-.476.557-.715.836-.822 1.18-.107.345-.071.717.001 1.46l.066.677c.253 2.617.38 3.925-.386 4.506-.766.582-1.918.052-4.221-1.009l-.595-.274c-.655-.301-.982-.452-1.329-.452s-.674.151-1.329.452l-.595.274c-2.303 1.06-3.455 1.59-4.221 1.01-.766-.582-.639-1.89-.386-4.507l.066-.676c.072-.744.108-1.116.001-1.46-.107-.345-.346-.624-.822-1.181l-.434-.507C.603 9.469-.235 8.489.057 7.548.35 6.607 1.58 6.329 4.04 5.772l.636-.144c.699-.158 1.048-.237 1.329-.45.281-.213.46-.536.82-1.182l.328-.588z"/></svg></span>{%- endfor -%}</span>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
    </div>
    <h2 class="h2">{{ section.settings.heading | escape }}</h2>
  </div>
  {%- if section.blocks.size > 0 -%}
  <review-slider data-reveal style="--d: 120ms">
    <div class="rslider">
      <div class="rslider__track">
        {%- for block in section.blocks -%}
          {%- assign n = forloop.index0 | modulo: 5 | plus: 1 -%}
          <article class="rcard{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            <div class="rcard__copy">
              <div class="rcard__stars"><b aria-hidden="true">★★★★★</b><span>{{ section.settings.rating_label | escape }}</span></div>
              <h3 class="rcard__title">{{ block.settings.title | escape }}</h3>
              <p class="rcard__text">{{ block.settings.text | escape }}</p>
              <span class="rcard__name">{{ block.settings.name | escape }}</span>
            </div>
            <div class="rcard__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '220px', alt: block.settings.name }}
              {%- else -%}
                <img src="{{ 'review-' | append: n | append: '-c.jpg' | asset_url }}" alt="" loading="lazy" width="440" height="760">
              {%- endif -%}
              {%- if block.settings.video != blank -%}<a class="rcard__play" href="{{ block.settings.video }}" target="_blank" rel="noopener" aria-label="Play video review"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg></a>{%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.blocks.size > 1 -%}
    <div class="rnav">
      <button type="button" class="rnav__btn" data-prev aria-label="Previous review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
      <div class="rdots">{%- for block in section.blocks -%}<button type="button"{% if forloop.first %} class="is-active"{% endif %} aria-label="Review {{ forloop.index }}"></button>{%- endfor -%}</div>
      <button type="button" class="rnav__btn" data-next aria-label="Next review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>
    {%- endif -%}
  </review-slider>
  {%- endif -%}
</section>
{% schema %}
{"name":"Testimonials","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Loved by pups. Trusted by parents."},
{"type":"text","id":"heading","label":"Heading","default":"When your dog is happy, you're happy."},
{"type":"text","id":"rating_label","label":"Rating label","default":"5 Star Ratings"}],
"blocks":[{"type":"review","name":"Review","settings":[
{"type":"text","id":"title","label":"Headline","default":"My senior dog just loves them."},
{"type":"textarea","id":"text","label":"Review"},
{"type":"text","id":"name","label":"Name","default":"Debbie B. - Mom of Roxy"},
{"type":"image_picker","id":"image","label":"Photo"},
{"type":"url","id":"video","label":"Video link","info":"Optional — shows a play button"}]}],
"presets":[{"name":"Testimonials","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}
