<article class="page-section">
  <div class="page-width--narrow">
    <div class="section-heading">
      <p class="section-heading__eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</p>
      <h1 class="section-heading__title">{{ article.title }}</h1>
    </div>

    {%- if article.image -%}
      <div style="border-radius: 24px; overflow: hidden; margin: 32px 0;">
        {{ article.image | image_url: width: 1200 | image_tag: alt: article.image.alt, style: 'width:100%; display:block;' }}
      </div>
    {%- endif -%}

    <div class="rte">
      {{ article.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
