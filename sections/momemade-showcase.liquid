<section class="momemade-showcase">
  <div class="momemade-section-heading">
    {%- if section.settings.eyebrow != blank -%}
      <p class="momemade-section-heading__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="momemade-section-heading__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="momemade-section-heading__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </div>

  <div class="momemade-showcase__grid">
    {%- for block in section.blocks -%}
      <article class="momemade-showcase__card" style="--card-accent: {{ block.settings.accent }};" {{ block.shopify_attributes }}>
        <div class="momemade-showcase__card-media">
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1150
              | image_tag: class: 'momemade-showcase__card-image', widths: '575, 860, 1150', sizes: '(max-width: 749px) 100vw, 50vw', alt: block.settings.image.alt
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'momemade-showcase__card-placeholder' }}
          {%- endif -%}
        </div>
        <div class="momemade-showcase__card-body">
          <div class="momemade-showcase__card-text">
            {%- if block.settings.eyebrow != blank -%}
              <p class="momemade-showcase__card-eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <h3 class="momemade-showcase__card-title">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="momemade-showcase__card-description">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link | default: '#' }}" class="momemade-showcase__card-button">
              {{ block.settings.button_label }}
              <span class="momemade-showcase__card-button-arrow" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% style %}
.momemade-section-heading {
  text-align: center;
  max-width: 700px;
  margin-inline: auto;
}

.momemade-section-heading__eyebrow {
  font-family: var(--momemade-font-secondary, 'Jost', 'Century Gothic', sans-serif);
  font-weight: 700;
  font-size: 14px;
  line-height: 1.7;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: #090b00;
  margin: 0 0 4px;
}

.momemade-section-heading__title {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
  font-size: clamp(36px, 5vw, 64px);
  letter-spacing: -1px;
  line-height: 1;
  margin: 0 0 12px;
}

.momemade-section-heading__subtitle {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 400;
  font-size: 16px;
  line-height: 28px;
  opacity: 0.8;
  margin: 0 auto;
  max-width: 558px;
}

  .momemade-showcase {
    background: #f5dfe2;
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: center;
    padding: 56px 40px;
  }

  .momemade-showcase__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    max-width: 1174px;
  }

  .momemade-showcase__card {
    background: #f4f0ea;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .momemade-showcase__card-media {
    background: #ede8df;
    aspect-ratio: 575 / 363;
    overflow: hidden;
  }

  .momemade-showcase__card-image,
  .momemade-showcase__card-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .momemade-showcase__card-body {
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: 24px;
    flex: 1;
  }

  .momemade-showcase__card-eyebrow {
    font-family: var(--momemade-font-secondary, 'Jost', 'Century Gothic', sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--card-accent);
    margin: 0 0 8px;
  }

  .momemade-showcase__card-title {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 36px;
    line-height: 40px;
    letter-spacing: -1px;
    margin: 0 0 16px;
  }

  .momemade-showcase__card-description {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 400;
    font-size: 16px;
    line-height: 28px;
    max-width: 450px;
    margin: 0;
  }

  .momemade-showcase__card-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 16px 32px;
    background: var(--card-accent);
    color: #ffffff;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .momemade-showcase__card-button:hover {
    opacity: 0.85;
  }

  .momemade-showcase__card-button-arrow {
    margin-left: 10px;
    display: inline-flex;
    align-items: center;
  }

  @media screen and (max-width: 989px) {
    .momemade-showcase {
      padding: 72px 40px;
    }

    .momemade-section-heading__title {
      font-size: 56px;
      line-height: 60px;
    }
  }

  @media screen and (max-width: 749px) {
    .momemade-showcase {
      padding: 56px 20px;
      gap: 24px;
    }

    .momemade-showcase__grid {
      grid-template-columns: 1fr;
    }

    .momemade-section-heading__title {
      font-size: 48px;
      line-height: 56px;
    }

    .momemade-section-heading__subtitle {
      font-size: 14px;
      line-height: 20px;
    }

    .momemade-showcase__card-title {
      font-size: 32px;
      line-height: 40px;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Momemade showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What we make"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Two products. One standard"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Simple ingredients for what goes in your dog. Thoughtful materials for what goes on your dog."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Kitchen-baked · Plant-based · Limited ingredient"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Dog Biscuits"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "You’ve tried everything. MOMEMADE is different. Kitchen-baked, limited ingredient biscuits for dogs with allergies and sensitive stomachs — made in a kitchen, not a factory. You could make these yourself — we just did it for you."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP BISCUITS"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "accent",
          "label": "Accent color",
          "default": "#D4A0C0"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product showcase",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "eyebrow": "Kitchen-baked · Plant-based · Limited ingredient",
            "title": "Dog Biscuits",
            "text": "You’ve tried everything. MOMEMADE is different. Kitchen-baked, limited ingredient biscuits for dogs with allergies and sensitive stomachs — made in a kitchen, not a factory. You could make these yourself — we just did it for you.",
            "button_label": "SHOP BISCUITS",
            "accent": "#D4A0C0"
          }
        },
        {
          "type": "card",
          "settings": {
            "eyebrow": "Low-impact fabrics · Reversible · No plastic",
            "title": "Dog Bandanas",
            "text": "Handmade from surplus, thrifted, and upcycled fabrics. Reversible — two looks, one bandana. Each design made once. When they’re gone, they’re gone.",
            "button_label": "SHOP BANDANAS",
            "accent": "#84C99A"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
