<div class="page-section">
  <div class="page-width--narrow">
    <div class="section-heading">
      <h1 class="section-heading__title">Order {{ order.name }}</h1>
      <p class="section-heading__subtitle">Placed on {{ order.created_at | date: '%B %d, %Y' }}</p>
    </div>

    <ul style="list-style: none; padding: 0; margin-top: 40px; display: grid; gap: 12px;">
      {%- for line_item in order.line_items -%}
        <li style="background: var(--color-cream); border-radius: 16px; padding: 16px 20px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
          <span>{{ line_item.title }} × {{ line_item.quantity }}</span>
          <span>{{ line_item.final_line_price | money }}</span>
        </li>
      {%- endfor -%}
    </ul>

    <div style="margin-top: 24px; text-align: right;">
      <p>Subtotal: {{ order.line_items_subtotal_price | money }}</p>
      {%- for shipping_method in order.shipping_methods -%}
        <p>Shipping ({{ shipping_method.title }}): {{ shipping_method.price | money }}</p>
      {%- endfor -%}
      <p><strong>Total: {{ order.total_price | money }}</strong></p>
    </div>

    <p style="margin-top: 32px;">
      <a href="{{ routes.account_url }}" class="btn btn--outline">Back to account</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Order",
  "settings": []
}
{% endschema %}
