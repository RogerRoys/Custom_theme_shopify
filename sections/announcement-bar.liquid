{%- if section.settings.text != blank -%}
  <div class="announcement-bar" role="region" aria-label="Announcement">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement-bar__text">{{ section.settings.text }}</a>
    {%- else -%}
      <p class="announcement-bar__text">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% style %}
  .announcement-bar {
    background: {{ section.settings.background }};
    color: {{ section.settings.text_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 20px;
  }

  .announcement-bar__text {
    margin: 0;
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }
{% endstyle %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "🔥 FREE SHIPPING ON ALL U.S. ORDERS OVER $50! 🔥"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#D49ED7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#090B00"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
