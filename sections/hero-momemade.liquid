<section class="hero">
  <div class="hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <div class="hero__heading-wrap">
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
        {%- if section.settings.show_sparkle -%}
          <span class="hero__sparkle">{% render 'icon', name: 'sparkle' %}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="hero__buttons">
          {%- for block in section.blocks -%}
            <a
              href="{{ block.settings.link | default: '#' }}"
              class="hero__btn hero__btn--{{ block.settings.style }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero__media-wrap">
      <div class="hero__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: class: 'hero__image', widths: '760, 1080, 1600', sizes: '(max-width: 749px) 100vw, 50vw', alt: section.settings.image.alt
          }}
        {%- else -%}
          <div class="hero__image-placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_badge -%}
        <div class="hero__badge" aria-hidden="true">
          {% render 'icon', name: 'badge-flower' %}
          <span class="hero__badge-text">{{ section.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.show_paw -%}
        <span class="hero__paw" aria-hidden="true">{% render 'icon', name: 'paw' %}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% style %}
  .hero {
    background: var(--color-dark);
    padding: 24px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: stretch;
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 66px 56px;
    position: relative;
  }

  .hero__eyebrow {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 14px;
    line-height: 20px;
    color: var(--color-pink);
    margin: 0 0 20px;
  }

  .hero__heading-wrap {
    position: relative;
    max-width: 560px;
  }

  .hero__heading {
    font-size: clamp(40px, 4.2vw, 64px);
    line-height: 1;
    letter-spacing: -1px;
    color: var(--color-blush);
    margin: 0 0 20px;
  }

  .hero__sparkle {
    position: absolute;
    top: -14px;
    right: -6px;
    width: 85px;
    height: 84px;
    color: var(--color-mint);
  }

  .hero__sparkle svg {
    width: 100%;
    height: 100%;
  }

  .hero__subheading {
    font-size: 16px;
    line-height: 28px;
    color: var(--color-blush-80);
    max-width: 546px;
    margin: 0 0 64px;
  }

  .hero__buttons {
    display: flex;
    gap: 10px;
    width: 100%;
    max-width: 580px;
  }

  .hero__btn {
    flex: 1 0 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 24px 10px;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 16px;
    line-height: 20px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .hero__btn:hover {
    opacity: 0.85;
  }

  .hero__btn--pink {
    background: var(--color-pink);
    color: var(--color-dark);
  }

  .hero__btn--mint {
    background: var(--color-mint);
    color: var(--color-dark);
  }

  .hero__btn--outline {
    background: transparent;
    border: 1px solid #ffffff;
    color: #ffffff;
  }

  .hero__media-wrap {
    position: relative;
  }

  .hero__media {
    border-radius: 24px;
    overflow: hidden;
    height: 100%;
    min-height: 560px;
  }

  .hero__image,
  .hero__image-placeholder,
  .hero__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero__image-placeholder {
    background: var(--color-cream-dark);
  }

  .hero__badge {
    position: absolute;
    top: 28px;
    left: 36px;
    width: 154px;
    height: 154px;
    color: var(--color-pink);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: hero-badge-spin 24s linear infinite;
  }

  .hero__badge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.92;
  }

  .hero__badge-text {
    position: relative;
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 20px;
    line-height: 20px;
    letter-spacing: -1px;
    text-align: center;
    text-transform: uppercase;
    color: #ffffff;
    max-width: 110px;
  }

  @keyframes hero-badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero__badge-text {
    animation: hero-badge-spin 24s linear infinite reverse;
  }

  .hero__paw {
    position: absolute;
    bottom: -46px;
    left: -100px;
    width: 198px;
    height: 207px;
    color: var(--color-mint);
    transform: rotate(-12deg);
    pointer-events: none;
  }

  .hero__paw svg {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 989px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__content {
      padding: 48px 16px 32px;
      order: 1;
    }

    .hero__media-wrap {
      order: 2;
    }

    .hero__media {
      min-height: 420px;
    }

    .hero__buttons {
      flex-direction: column;
      max-width: none;
    }

    .hero__paw {
      left: auto;
      right: -40px;
      bottom: -40px;
      width: 140px;
      height: 146px;
    }

    .hero__badge {
      width: 110px;
      height: 110px;
      top: 16px;
      left: 16px;
    }

    .hero__badge-text {
      font-size: 14px;
      line-height: 14px;
      max-width: 80px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Momemade hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DOG GOODS. MOM APPROVED. · HUDSON VALLEY, NY"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "“If I wouldn't give it to my own dog, I don't make it”"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Plant-based biscuits baked in our kitchen. Bandanas sewn one at a time from reclaimed fabrics. Simple ingredients for what goes in your dog. Thoughtful materials for what goes on your dog."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "header",
      "content": "Decorations"
    },
    {
      "type": "checkbox",
      "id": "show_sparkle",
      "label": "Show sparkle doodle",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_paw",
      "label": "Show paw print",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Approved by vet"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "SHOP BISCUITS"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "pink", "label": "Pink" },
            { "value": "mint", "label": "Mint" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "pink"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Momemade hero",
      "blocks": [
        { "type": "button", "settings": { "label": "SHOP BISCUITS", "style": "pink" } },
        { "type": "button", "settings": { "label": "SHOP BANDANAS", "style": "mint" } },
        { "type": "button", "settings": { "label": "FIND YOUR BISCUIT", "style": "outline" } }
      ]
    }
  ]
}
{% endschema %}
