<section
  class="momemade-ticker"
  aria-label="Highlights"
  style="
    --mm-ticker-bg: {{ section.settings.background }};
    --mm-ticker-text: {{ section.settings.text_color }};
    --mm-ticker-dot: {{ section.settings.dot_color }};
    {% if section.settings.show_border %}--mm-ticker-border: 1.5px solid {{ section.settings.border_color }};{% else %}--mm-ticker-border: 0;{% endif %}
  "
>
  <div class="momemade-ticker__viewport">
    {%- capture ticker_items -%}
      {%- for block in section.blocks -%}
        <span class="momemade-ticker__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        <span class="momemade-ticker__dot" aria-hidden="true"></span>
      {%- endfor -%}
    {%- endcapture -%}

    <div class="momemade-ticker__track" style="--ticker-duration: {{ section.settings.speed }}s;">
      <div class="momemade-ticker__group">{{ ticker_items }}</div>
      <div class="momemade-ticker__group" aria-hidden="true">{{ ticker_items }}</div>
    </div>
  </div>
</section>

{% style %}
  .momemade-ticker {
    background: var(--mm-ticker-bg, #a0dbb3);
    border-top: var(--mm-ticker-border, 0);
    border-bottom: var(--mm-ticker-border, 0);
    padding: 25px 0 24px;
    overflow: hidden;
  }

  .momemade-ticker__viewport {
    overflow: hidden;
    white-space: nowrap;
  }

  .momemade-ticker__track {
    display: inline-flex;
    animation: momemade-ticker-scroll var(--ticker-duration, 60s) linear infinite;
  }

  .momemade-ticker:hover .momemade-ticker__track {
    animation-play-state: paused;
  }

  .momemade-ticker__group {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding-right: 16px;
  }

  .momemade-ticker__item {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -1px;
    color: var(--mm-ticker-text, #090b00);
    white-space: nowrap;
  }

  .momemade-ticker__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--mm-ticker-dot, #090b00);
    flex-shrink: 0;
  }

  @keyframes momemade-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .momemade-ticker__track {
      animation: none;
    }
  }

  @media screen and (max-width: 749px) {
    .momemade-ticker__item {
      font-size: 22px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Momemade ticker",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#A0DBB3",
      "info": "Frame 2: #A0DBB3 · Frame 1: #090B00"
