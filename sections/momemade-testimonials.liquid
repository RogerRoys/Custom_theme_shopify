{% comment %}
  Momemade testimonials — horizontal carousel of landscape review cards
  (redesign, Figma 937:3622). Each card: orange stars + review title +
  body + reviewer profile on the left, a portrait "reel" photo on the
  right. White round arrows below scroll the track. Mobile stacks the
  photo on top of the text inside each card.
{% endcomment %}

{%- capture star_svg -%}
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.95 6.36 6.97.86-5.14 4.78 1.35 6.88L12 17.4l-6.13 3.48 1.35-6.88L2.08 9.22l6.97-.86z"/></svg>
{%- endcapture -%}

<section class="momemade-testimonials" id="momemade-testimonials-{{ section.id }}">
  <div class="momemade-testimonials__head">
    <div class="momemade-testimonials__head-badge">
      <span class="momemade-testimonials__head-stars" aria-hidden="true">
        {% for i in (1..5) %}{{ star_svg }}{% endfor %}
      </span>
      {%- if section.settings.eyebrow != blank -%}
        <p class="momemade-testimonials__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
    </div>
    <h2 class="momemade-testimonials__title">{{ section.settings.title }}</h2>
  </div>

  <div class="momemade-testimonials__carousel">
    <div class="momemade-testimonials__track" data-testimonials-track>
      {%- for block in section.blocks -%}
        <article class="momemade-testimonials__card" {{ block.shopify_attributes }}>
          <div class="momemade-testimonials__card-body">
            <div class="momemade-testimonials__card-main">
              <div class="momemade-testimonials__card-rating">
                <span class="momemade-testimonials__card-stars" aria-hidden="true">
                  {% for i in (1..5) %}{{ star_svg }}{% endfor %}
                </span>
                <span class="momemade-testimonials__card-rating-text">5 Star Ratings</span>
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="momemade-testimonials__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.quote != blank -%}
                <p class="momemade-testimonials__card-text">{{ block.settings.quote }}</p>
              {%- endif -%}
            </div>
            <div class="momemade-testimonials__profile">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 96 | image_tag: class: 'momemade-testimonials__avatar', alt: block.settings.name }}
              {%- else -%}
                <span class="momemade-testimonials__avatar momemade-testimonials__avatar--initial" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
              {%- endif -%}
              <span class="momemade-testimonials__profile-text">
                <span class="momemade-testimonials__name">{{ block.settings.name }}</span>
                {%- if block.settings.subtext != blank -%}
                  <span class="momemade-testimonials__subtext">{{ block.settings.subtext }}</span>
                {%- endif -%}
              </span>
            </div>
          </div>
          <div class="momemade-testimonials__photo">
            {%- if block.settings.photo != blank -%}
              {{ block.settings.photo | image_url: width: 640 | image_tag: class: 'momemade-testimonials__photo-image', widths: '320, 480, 640', sizes: '(max-width: 749px) 90vw, 240px', alt: block.settings.name }}
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>

  <div class="momemade-testimonials__nav">
    <button type="button" class="momemade-testimonials__arrow" data-testimonials-prev aria-label="Previous reviews">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M14.5 5.5 8 12l6.5 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button type="button" class="momemade-testimonials__arrow" data-testimonials-next aria-label="Next reviews">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M9.5 5.5 16 12l-6.5 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('momemade-testimonials-{{ section.id }}');
    if (!root || root.dataset.reviewsInit) return;
    root.dataset.reviewsInit = '1';

    var track = root.querySelector('[data-testimonials-track]');
    var prev = root.querySelector('[data-testimonials-prev]');
    var next = root.querySelector('[data-testimonials-next]');
    if (!track || !prev || !next) return;

    function step() {
      var card = track.querySelector('.momemade-testimonials__card');
      return card ? card.getBoundingClientRect().width + 11 : 400;
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth - 1;
      prev.disabled = track.scrollLeft <= 0;
      next.disabled = track.scrollLeft >= max;
    }

    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% style %}
  .momemade-testimonials {
    background: #f5dfe2;
    border-bottom: 1.5px solid rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
    padding: 80px;
  }

  .momemade-testimonials__head {
    text-align: center;
    max-width: 980px;
  }

  .momemade-testimonials__head-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .momemade-testimonials__head-stars,
  .momemade-testimonials__card-stars {
    display: inline-flex;
    gap: 4px;
    color: #fb7813;
  }

  .momemade-testimonials__head-stars svg {
    width: 18px;
    height: 18px;
  }

  .momemade-testimonials__eyebrow {
    font-family: var(--momemade-font-secondary, 'Jost', 'Century Gothic', sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #090b00;
    margin: 0;
  }

  .momemade-testimonials__title {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(36px, 4.2vw, 64px);
    line-height: 1;
    letter-spacing: -1px;
    color: #090b00;
    margin: 0;
  }

  .momemade-testimonials__carousel {
    width: 100%;
    max-width: 1352px;
  }

  .momemade-testimonials__track {
    display: flex;
    gap: 11px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .momemade-testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .momemade-testimonials__card {
    flex: 0 0 784px;
    scroll-snap-align: start;
    display: flex;
    gap: 36px;
    background: #ffffff;
    padding: 30px 30px 30px 40px;
    min-height: 430px;
  }

  .momemade-testimonials__card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 0;
  }

  .momemade-testimonials__card-rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .momemade-testimonials__card-stars svg {
    width: 20px;
    height: 20px;
  }

  .momemade-testimonials__card-rating-text {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #fb7813;
  }

  .momemade-testimonials__card-title {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 20px;
    line-height: 24px;
    color: #161616;
    margin: 0 0 12px;
  }

  .momemade-testimonials__card-text {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #161616;
    margin: 0;
  }

  .momemade-testimonials__profile {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .momemade-testimonials__avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    flex: 0 0 auto;
  }

  .momemade-testimonials__avatar--initial {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5dfe2;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 18px;
    color: #090b00;
  }

  .momemade-testimonials__name {
    display: block;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #161616;
  }

  .momemade-testimonials__subtext {
    display: block;
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-size: 12px;
    line-height: 20px;
    color: rgba(22, 22, 22, 0.6);
  }

  .momemade-testimonials__photo {
    flex: 0 0 240px;
    height: 370px;
    align-self: center;
    border-radius: 10px;
    overflow: hidden;
    background: #f5f4f1;
  }

  .momemade-testimonials__photo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .momemade-testimonials__nav {
    display: flex;
    gap: 12px;
  }

  .momemade-testimonials__arrow {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: #ffffff;
    color: #090b00;
    border: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .momemade-testimonials__arrow:hover {
    opacity: 0.8;
  }

  .momemade-testimonials__arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  /* Tablet: one narrower card per view */
  @media screen and (max-width: 989px) {
    .momemade-testimonials {
      padding: 72px 40px;
      gap: 36px;
    }

    .momemade-testimonials__title {
      font-size: 56px;
      line-height: 60px;
    }

    .momemade-testimonials__card {
      flex: 0 0 680px;
      max-width: calc(100vw - 80px);
    }

    .momemade-testimonials__photo {
      flex: 0 0 220px;
    }
  }

  /* Mobile: vertical cards, photo on top */
  @media screen and (max-width: 749px) {
    .momemade-testimonials {
      padding: 56px 20px;
      gap: 28px;
    }

    .momemade-testimonials__title {
      font-size: 40px;
      line-height: 44px;
    }

    .momemade-testimonials__card {
      flex: 0 0 85%;
      max-width: none;
      flex-direction: column-reverse;
      gap: 20px;
      padding: 20px;
      min-height: 0;
    }

    .momemade-testimonials__card-body {
      padding: 0;
    }

    .momemade-testimonials__photo {
      flex: 0 0 auto;
      width: 100%;
      height: 240px;
      align-self: stretch;
    }

    .momemade-testimonials__card-stars svg {
      width: 16px;
      height: 16px;
    }

    .momemade-testimonials__card-rating-text {
      font-size: 14px;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Momemade testimonials",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Loved by pups. Trusted by parents."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "When your dog is happy, you’re happy."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "My senior dog just loves them."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review text"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Debbie B."
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Descriptor",
          "default": "Mom of Roxy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Momemade testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
