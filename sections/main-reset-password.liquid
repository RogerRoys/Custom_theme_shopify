<div class="page-section">
  <div class="page-width--narrow" style="max-width: 480px;">
    <div class="section-heading">
      <h1 class="section-heading__title">Reset password</h1>
      <p class="section-heading__subtitle">Enter a new password for your account.</p>
    </div>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="field">
        <label for="reset-password">New password</label>
        <input type="password" id="reset-password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="reset-password-confirm">Confirm password</label>
        <input type="password" id="reset-password-confirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="btn btn--dark btn--full">Reset password</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
