<section class="ticker" aria-label="Highlights">
  <div class="ticker__viewport">
    {%- capture ticker_items -%}
      {%- for block in section.blocks -%}
        <span class="ticker__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        <span class="ticker__dot" aria-hidden="true"></span>
      {%- endfor -%}
    {%- endcapture -%}

    <div class="ticker__track" style="--ticker-duration: {{ section.settings.speed }}s;">
      <div class="ticker__group">{{ ticker_items }}</div>
      <div class="ticker__group" aria-hidden="true">{{ ticker_items }}</div>
    </div>
  </div>
</section>

{% style %}
  .ticker {
    background: var(--color-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding: 25px 0 24px;
    overflow: hidden;
  }

  .ticker__viewport {
    overflow: hidden;
    white-space: nowrap;
  }

  .ticker__track {
    display: inline-flex;
    animation: ticker-scroll var(--ticker-duration, 60s) linear infinite;
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  .ticker__group {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding-right: 16px;
  }

  .ticker__item {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
    font-size: 32px;
    line-height: 1;
    letter-spacing: -1px;
    color: var(--color-pink);
    white-space: nowrap;
  }

  .ticker__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-pink);
    flex-shrink: 0;
  }

  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track {
      animation: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ticker__item {
      font-size: 22px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Scrolling ticker",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll duration (seconds)",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 60,
      "info": "Lower is faster."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Small-batch baked in Hudson Valley, NY"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling ticker",
      "blocks": [
        { "type": "item", "settings": { "text": "Small-batch baked in Hudson Valley, NY" } },
