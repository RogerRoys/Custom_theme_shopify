<div class="ticker" style="--speed: {{ section.settings.speed }}s">
  <div class="ticker__track" aria-hidden="true">
    {%- for i in (1..2) -%}
      <div class="ticker__half">
        {%- for r in (1..3) -%}{%- for block in section.blocks -%}<span class="ticker__item">{{ block.settings.text | escape }}</span>{%- endfor -%}{%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
  <p class="visually-hidden">{% for block in section.blocks %}{{ block.settings.text | escape }}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
</div>
{% schema %}
{"name":"Ticker","settings":[{"type":"range","id":"speed","min":15,"max":80,"step":1,"unit":"s","label":"Loop duration","default":38}],
"blocks":[{"type":"item","name":"Item","settings":[{"type":"text","id":"text","label":"Text","default":"Handmade in small batches"}]}],
"presets":[{"name":"Ticker","blocks":[{"type":"item","settings":{"text":"No preservatives"}},{"type":"item","settings":{"text":"Allergy & sensitive belly friendly"}},{"type":"item","settings":{"text":"Handmade in small batches"}}]}]}
{% endschema %}
