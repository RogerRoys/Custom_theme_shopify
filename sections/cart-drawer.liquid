{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign total = cart.total_price
  assign remaining = threshold | minus: total
  assign pct = 0
  if threshold > 0
    assign pct = total | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
<div class="overlay" data-overlay="cart" id="CartDrawer" aria-hidden="true">
  <div class="overlay__scrim" data-close="cart"></div>
  <div class="drawer drawer--right" role="dialog" aria-modal="true" aria-label="Your bag">
    <div class="cd" id="CartDrawerInner">
      <div class="cd__head">
        <span class="cd__title">Your bag ({{ cart.item_count }})</span>
        <button type="button" class="icon-btn" data-close="cart" aria-label="Close bag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
      </div>
      {%- if threshold > 0 -%}
        <div class="cd__ship">
          <span class="eyebrow">
            {%- if total >= threshold -%}You’ve unlocked free shipping!
            {%- elsif total > 0 -%}{{ remaining | money }} away from free shipping
            {%- else -%}Free shipping on orders over {{ threshold | money_without_trailing_zeros }}{%- endif -%}
          </span>
          <div class="meter"><i style="width: {{ pct }}%"></i></div>
        </div>
      {%- endif -%}
      <div class="cd__items">
        {%- if cart.item_count == 0 -%}
          <div class="cd__empty">
            <span class="cd__empty-title">Your bag is empty</span>
            <p>{{ settings.empty_cart_text }}</p>
            <a class="btn" href="{{ settings.empty_cart_link | default: routes.all_products_collection_url }}">{{ settings.empty_cart_label | escape }}</a>
          </div>
        {%- else -%}
          {%- for item in cart.items -%}{% render 'cart-line', item: item, index: forloop.index %}{%- endfor -%}
        {%- endif -%}
      </div>
      {%- if cart.item_count > 0 -%}
        <form action="{{ routes.cart_url }}" method="post" class="cd__foot">
          <div class="cd__total"><span>Subtotal</span><span>{{ cart.total_price | money }}</span></div>
          <p class="cd__note">Shipping and taxes calculated at checkout.</p>
          <button type="submit" name="checkout" class="btn btn--ink">Checkout · {{ cart.total_price | money }}</button>
          <a href="{{ routes.cart_url }}" class="link-btn">View bag</a>
        </form>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{"name":"Cart drawer","settings":[]}
{% endschema %}
