{%- liquid
  assign ar_d = ''
  assign ar_m = ''
  assign b0 = section.blocks.first
  if b0 and section.settings.height == 'adapt'
    if b0.settings.desktop_type == 'video' and b0.settings.video != blank
      assign ar_d = b0.settings.video.aspect_ratio
    elsif b0.settings.image != blank
      assign ar_d = b0.settings.image.aspect_ratio
      if b0.settings.image_2 != blank
        assign ar_d = ar_d | plus: b0.settings.image_2.aspect_ratio
      endif
    endif
    if b0.settings.mobile_type == 'video' and b0.settings.mobile_video != blank
      assign ar_m = b0.settings.mobile_video.aspect_ratio
    elsif b0.settings.mobile_type == 'image' and b0.settings.mobile_image != blank
      assign ar_m = b0.settings.mobile_image.aspect_ratio
    elsif b0.settings.mobile_type == 'same'
      if b0.settings.desktop_type == 'video' and b0.settings.video != blank
        assign ar_m = b0.settings.video.aspect_ratio
      elsif b0.settings.image != blank
        assign ar_m = b0.settings.image.aspect_ratio
      endif
    endif
  endif
-%}
<hero-slideshow class="hero{% if ar_d != '' %} hero--adapt-d{% endif %}{% if ar_m != '' %} hero--adapt-m{% endif %}" style="{% if ar_d != '' %}--ar-d: {{ ar_d }};{% endif %}{% if ar_m != '' %}--ar-m: {{ ar_m }};{% endif %}" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}" aria-roledescription="carousel">
  {%- for block in section.blocks -%}
    {%- liquid
      if forloop.first
        assign lz = 'eager'
      else
        assign lz = 'lazy'
      endif
      assign heading = block.settings.heading | escape | newline_to_br
      if block.settings.highlight != blank
        assign hw = block.settings.highlight | escape
        assign hw_html = '<span class="hl"><i></i><span>' | append: hw | append: '</span></span>'
        assign heading = heading | replace_first: hw, hw_html
      endif
      assign htag = 'h2'
      if forloop.first and template.name == 'index'
        assign htag = 'h1'
      endif
    -%}
    <div class="hero__slide{% if forloop.first %} is-active{% endif %}" aria-roledescription="slide" {{ block.shopify_attributes }}>
      {%- liquid
        assign d_type = block.settings.desktop_type
        assign m_type = block.settings.mobile_type
        assign has_mobile = true
        if m_type == 'same'
          assign has_mobile = false
        endif
        if forloop.first
          assign fb1 = 'hero-1a-c.jpg'
          assign fb2 = 'hero-1b-c.jpg'
        else
          assign fb1 = 'hero-2-c.jpg'
          assign fb2 = ''
        endif
      -%}
      <div class="hero__media{% if has_mobile %} hero__media--desktop{% endif %}">
        {%- if d_type == 'video' and block.settings.video != blank -%}
          {{ block.settings.video | video_tag: image_size: '1920x', loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'hero__video' }}
        {%- elsif d_type == 'video' and block.settings.video_url != blank -%}
          <video class="hero__video" src="{{ block.settings.video_url }}" loop muted playsinline preload="metadata"{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 1920 }}"{% endif %}></video>
        {%- elsif block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 2400 | image_tag: loading: lz, widths: '750,1100,1500,1900,2400', sizes: '100vw', alt: block.settings.image.alt }}
          {%- if block.settings.image_2 != blank -%}
            {{ block.settings.image_2 | image_url: width: 1600 | image_tag: loading: lz, widths: '750,1100,1600', sizes: '50vw', alt: block.settings.image_2.alt }}
          {%- endif -%}
        {%- else -%}
          <img src="{{ fb1 | asset_url }}" alt="" width="1435" height="1800" loading="{{ lz }}">
          {%- if fb2 != '' -%}<img src="{{ fb2 | asset_url }}" alt="" width="1435" height="1800" loading="{{ lz }}">{%- endif -%}
        {%- endif -%}
      </div>
      {%- if has_mobile -%}
        <div class="hero__media hero__media--mobile">
          {%- if m_type == 'video' and block.settings.mobile_video != blank -%}
            {{ block.settings.mobile_video | video_tag: image_size: '900x', loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'hero__video' }}
          {%- elsif m_type == 'video' and block.settings.mobile_video_url != blank -%}
            <video class="hero__video" src="{{ block.settings.mobile_video_url }}" loop muted playsinline preload="metadata"{% if block.settings.mobile_image != blank %} poster="{{ block.settings.mobile_image | image_url: width: 900 }}"{% endif %}></video>
          {%- elsif block.settings.mobile_image != blank -%}
            {{ block.settings.mobile_image | image_url: width: 1200 | image_tag: loading: lz, widths: '450,750,1000,1200', sizes: '100vw', alt: block.settings.mobile_image.alt }}
          {%- elsif block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: loading: lz, widths: '450,750,1000,1200', sizes: '100vw', alt: block.settings.image.alt }}
          {%- else -%}
            <img src="{{ fb1 | asset_url }}" alt="" width="1435" height="1800" loading="{{ lz }}">
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="hero__shade"></div>
      <div class="hero__content">
        {%- if block.settings.eyebrow != blank -%}<p class="hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
        <{{ htag }} class="hero__title hero__title--{{ block.settings.size }}">{{ heading }}</{{ htag }}>
        {%- if block.settings.text != blank -%}<p class="hero__text">{{ block.settings.text | escape }}</p>{%- endif -%}
        {%- if block.settings.button_1_label != blank or block.settings.button_2_label != blank -%}
          <div class="hero__btns">
            {%- if block.settings.button_1_label != blank -%}<a class="btn" href="{{ block.settings.button_1_link | default: routes.all_products_collection_url }}">{{ block.settings.button_1_label | escape }}</a>{%- endif -%}
            {%- if block.settings.button_2_label != blank -%}<a class="btn btn--mint" href="{{ block.settings.button_2_link | default: routes.all_products_collection_url }}">{{ block.settings.button_2_label | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
  {%- if section.blocks.size > 1 -%}
    <div class="hero__ctl">
      <div class="hero__count"><span data-label>1/{{ section.blocks.size }}</span><span class="hero__bar"><i></i></span></div>
      <button type="button" class="hero__arrow" data-prev aria-label="Previous slide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" class="hero__arrow" data-next aria-label="Next slide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
  {%- endif -%}
</hero-slideshow>
{% schema %}
{"name":"Hero slideshow","tag":"section","class":"section-hero","settings":[
{"type":"select","id":"height","label":"Hero height","options":[{"value":"adapt","label":"Adapt to first slide's image / video"},{"value":"full","label":"Fill screen (may crop)"}],"default":"adapt","info":"Adapt shows your media at its uploaded size — no cropping. Use the same size for every slide."},
{"type":"checkbox","id":"autoplay","label":"Auto-rotate slides","default":true},
{"type":"range","id":"speed","min":4,"max":12,"step":0.5,"unit":"s","label":"Time per slide","default":6.5}],
"blocks":[{"type":"slide","name":"Slide","settings":[
{"type":"header","content":"Desktop media"},
{"type":"select","id":"desktop_type","label":"Desktop media type","options":[{"value":"image","label":"Image"},{"value":"video","label":"Video"}],"default":"image"},
{"type":"image_picker","id":"image","label":"Desktop image","info":"Also used as the video cover while it loads"},
{"type":"image_picker","id":"image_2","label":"Second desktop image (split)","info":"Optional — shows two images side by side"},
{"type":"video","id":"video","label":"Desktop video","info":"Upload to Shopify. Plays muted on loop."},
{"type":"url","id":"video_url","label":"Or desktop video URL (.mp4)"},
{"type":"header","content":"Mobile media"},
{"type":"select","id":"mobile_type","label":"Mobile media type","options":[{"value":"same","label":"Same as desktop"},{"value":"image","label":"Image"},{"value":"video","label":"Video"}],"default":"same"},
{"type":"image_picker","id":"mobile_image","label":"Mobile image","info":"Portrait works best. Also used as the mobile video cover."},
{"type":"video","id":"mobile_video","label":"Mobile video"},
{"type":"url","id":"mobile_video_url","label":"Or mobile video URL (.mp4)"},
{"type":"header","content":"Content"},
{"type":"text","id":"eyebrow","label":"Eyebrow"},
{"type":"textarea","id":"heading","label":"Heading","default":"It’s not just a dog."},
{"type":"text","id":"highlight","label":"Highlighted word","info":"Must match a word in the heading — gets the lilac marker"},
{"type":"select","id":"size","label":"Heading size","options":[{"value":"lg","label":"Large"},{"value":"md","label":"Medium"}],"default":"lg"},
{"type":"textarea","id":"text","label":"Text"},
{"type":"text","id":"button_1_label","label":"Button 1 label","default":"Shop biscuits"},
{"type":"url","id":"button_1_link","label":"Button 1 link"},
{"type":"text","id":"button_2_label","label":"Button 2 label","default":"Shop bandanas"},
{"type":"url","id":"button_2_link","label":"Button 2 link"}]}],
"max_blocks":5,
"presets":[{"name":"Hero slideshow","blocks":[{"type":"slide"},{"type":"slide"}]}]}
{% endschema %}
