<div class="page-section">
  <div class="page-width">
    <div class="section-heading">
      <h1 class="section-heading__title">Search</h1>
      {%- if search.performed -%}
        <p class="section-heading__subtitle">
          {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms | escape }}”
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="search-input">Search</label>
      <input
        type="search"
        id="search-input"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search biscuits, bandanas…"
      >
      <button type="submit" class="btn btn--dark">Search</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        {%- if search.results.size > 0 -%}
          <ul class="product-grid" style="margin-top: 40px;">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a href="{{ item.url }}" class="product-card">
                    <div class="product-card__info">
                      <h3 class="product-card__title">{{ item.title }}</h3>
                    </div>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p style="text-align:center; margin-top: 40px;">No results found. Try a different search.</p>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% style %}
  .search-form {
    display: flex;
    gap: 12px;
    max-width: 560px;
    margin: 32px auto 0;
  }

  .search-form input {
    flex: 1;
    padding: 14px 16px;
    font-family: var(--font-body);
    font-size: 16px;
    border: 1px solid rgba(9, 11, 0, 0.2);
    border-radius: 12px;
  }
{% endstyle %}

{% schema %}
{
  "name": "Search page",
  "settings": []
}
{% endschema %}
