<script>
(function(){
function mmMotion(root){
  var noop={reveal:function(){},hero:function(){},stop:function(){}};
  if(!root||!window.IntersectionObserver||(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)) return noop;
  var EASE='cubic-bezier(.2,.7,.2,1)';
  var io=new IntersectionObserver(function(en){
    var i=0;
    en.forEach(function(x){
      if(!x.isIntersecting) return;
      var e=x.target, o=e.__mm; io.unobserve(e);
      e.style.transition='opacity 700ms '+EASE+' '+(i*90)+'ms, transform 700ms '+EASE+' '+(i*90)+'ms'; i++;
      e.style.opacity=o.op; e.style.transform=o.tf;
      setTimeout(function(){ e.style.transition=o.tr; }, 1600+i*90);
    });
  },{threshold:0.12,rootMargin:'0px 0px -40px 0px'});
  function reveal(){
    var sel='h2,h3,blockquote,p,article,form,a,img,[role="img"],[data-card]';
    var els=[];
    [].forEach.call(root.querySelectorAll('[data-screen-label]'),function(s){
      if(/^(Hero|Ticker|Top Banner)$/.test(s.getAttribute('data-screen-label'))) return;
      [].forEach.call(s.querySelectorAll(sel),function(e){ els.push(e); });
    });
    var set=new Set(els);
    els.forEach(function(e){
      if(e.__mm||!e.getClientRects().length) return;
      for(var p=e.parentElement;p&&p!==root;p=p.parentElement){ if(set.has(p)) return; }
      e.__mm={op:e.style.opacity,tf:e.style.transform,tr:e.style.transition};
      e.style.transition='none'; e.style.opacity='0'; e.style.transform='translateY(28px)';
      io.observe(e);
    });
  }
  function hero(){
    [].forEach.call(root.querySelectorAll('[data-screen-label="Hero"] [aria-hidden="false"]'),function(panel){
      if(!panel.getClientRects().length||!panel.animate) return;
      var items=[].filter.call(panel.querySelectorAll('span,h1,p,a'),function(e){ return !e.parentElement.closest('h1,p,a,span')||!panel.contains(e.parentElement.closest('h1,p,a,span')); });
      items.forEach(function(e,i){ e.animate([{opacity:0,transform:'translateY(18px)'},{opacity:1,transform:'none'}],{duration:800,delay:120+i*110,easing:EASE,fill:'backwards'}); });
    });
  }
  return {reveal:reveal,hero:hero,stop:function(){io.disconnect();}};
}
var root=document.getElementById('mm-{{ section.id }}'); if(!root||root.dataset.mmInit) return; root.dataset.mmInit='1';
var motion=null, autoplay={{ section.settings.autoplay | json }}, speed={{ section.settings.ticker_speed | default: 40 }}/1000, slide=0, timer;
function render(){
  root.querySelectorAll('[data-mm-slide]').forEach(function(el){var on=+el.getAttribute('data-mm-slide')===slide; el.style.opacity=on?'1':'0'; if(el.style.pointerEvents){el.style.pointerEvents=on?'auto':'none'; el.setAttribute('aria-hidden',on?'false':'true');}});
  root.querySelectorAll('[data-mm-label]').forEach(function(e){e.textContent=(slide+1)+'/2';});
  root.querySelectorAll('[data-mm-bar]').forEach(function(e){e.style.width=slide?'65px':'29px';});
  if(motion) motion.hero();
}
function start(){clearInterval(timer); if(autoplay) timer=setInterval(function(){slide=(slide+1)%2; render();},7000);}
function go(d){slide=(slide+d+2)%2; render(); start();}
function menu(open){root.querySelectorAll('.mm-menu').forEach(function(m){m.classList.toggle('is-open',open);}); root.querySelectorAll('[data-mm-click="toggleMenu"]').forEach(function(b){b.setAttribute('aria-expanded',open?'true':'false');});}
root.addEventListener('click',function(e){
  var b=e.target.closest('[data-mm-click]'); if(!b) return;
  var a=b.getAttribute('data-mm-click'), scope=b.closest('.mm-d,.mm-t,.mm-m')||root, el, step;
  if(a==='prevSlide') go(-1); else if(a==='nextSlide') go(1);
  else if(a==='toggleMenu') menu(!root.querySelector('.mm-menu.is-open'));
  else if(a==='closeMenu') menu(false);
  else if(a==='reviewsPrev'||a==='reviewsNext'){el=scope.querySelector('[data-mm-ref="setReviews"]'); if(!el) return; var c=el.querySelector('[data-card]'); step=c?c.getBoundingClientRect().width+24:600; el.scrollBy({left:(a==='reviewsNext'?1:-1)*step,behavior:'smooth'});}
  else if(a==='tilesPrev'||a==='tilesNext'){el=scope.querySelector('[data-mm-ref="setTiles"]'); if(!el||!el.firstElementChild) return; el.scrollBy({left:(a==='tilesNext'?1:-1)*(el.firstElementChild.getBoundingClientRect().width+30),behavior:'smooth'});}
});
if(/customer_posted=true/.test(location.search)){root.querySelectorAll('[data-mm-text="joinLabelA"],[data-mm-text="joinLabelB"]').forEach(function(e){e.textContent='JOINED';}); root.querySelectorAll('[data-mm-text="noteA"]').forEach(function(e){e.textContent='You\u2019re in \u2014 thanks for making your signup count.';});}
var tickers=[].slice.call(root.querySelectorAll('[data-mm-ref="setTicker"]')).map(function(el){return {el:el,x:0};}), last=performance.now();
function tick(t){var dt=Math.min(64,t-last); last=t; if(speed>0) tickers.forEach(function(k){var half=k.el.scrollWidth/2; if(!half) return; k.x-=dt*speed; if(-k.x>=half) k.x+=half; k.el.style.transform='translate3d('+k.x.toFixed(2)+'px,0,0)';}); requestAnimationFrame(tick);}
root.querySelectorAll('video.mm-vid').forEach(function(v){v.muted=true;v.setAttribute('muted','');v.setAttribute('playsinline','');var p=v.play();if(p&&p.catch)p.catch(function(){});});
motion=mmMotion(root); motion.reveal(); render(); start(); requestAnimationFrame(tick);
var mmBp=innerWidth<640?0:innerWidth<1100?1:2; addEventListener('resize',function(){var b=innerWidth<640?0:innerWidth<1100?1:2; if(b!==mmBp){mmBp=b; motion.reveal(); motion.hero();}});
})();
</script>
