<section class="section joni" id="story">
  <div class="joni__top">
    <div class="joni__copy" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="joni__title">{{ section.settings.heading | escape | newline_to_br }}</h2>
      <div class="joni__rte body rte">{{ section.settings.body }}</div>
      {%- if section.settings.button_label != blank -%}<a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}{% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
    </div>
    <div class="joni__media" data-reveal style="--d: 150ms">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', alt: section.settings.image.alt }}
      {%- else -%}
        <img src="{{ 'joni-main.jpg' | asset_url }}" alt="Joni" loading="lazy" width="1800" height="1324">
      {%- endif -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="joni__cards">
      {%- for block in section.blocks -%}
        {%- assign n = forloop.index0 | modulo: 3 | plus: 1 -%}
        <div class="jcard" data-reveal style="--d: {{ forloop.index0 | times: 120 }}ms" {{ block.shopify_attributes }}>
          <div class="jcard__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500,750,1000', sizes: '(min-width: 900px) 33vw, 100vw', alt: block.settings.image.alt }}
            {%- else -%}
              <img src="{{ 'joni-card-' | append: n | append: '.jpg' | asset_url }}" alt="" loading="lazy" width="1000" height="1300">
            {%- endif -%}
          </div>
          <div class="jcard__cap"><span>{{ block.settings.caption }}</span></div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{"name":"Meet Joni","settings":[
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Meet Joni"},
{"type":"textarea","id":"heading","label":"Heading","default":"The dog who started it all."},
{"type":"richtext","id":"body","label":"Story","default":"<p>When my daughter Alana adopted Joni, the rescue suspected she had allergies.</p>"},
{"type":"text","id":"button_label","label":"Button label","default":"Shop biscuits"},
{"type":"url","id":"button_link","label":"Button link"},
{"type":"image_picker","id":"image","label":"Image"}],
"blocks":[{"type":"card","name":"Photo card","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"inline_richtext","id":"caption","label":"Caption","default":"It’s <b>love</b>"}]}],
"max_blocks":3,
"presets":[{"name":"Meet Joni","blocks":[{"type":"card"},{"type":"card"},{"type":"card"}]}]}
{% endschema %}
