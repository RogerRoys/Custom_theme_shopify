{%- paginate blog.articles by 9 -%}
<section class="section">
  <div class="coll-head" data-reveal><span class="eyebrow">Journal</span><h1 class="h2">{{ blog.title }}</h1></div>
  <div class="grid">
    {%- for article in blog.articles -%}
      <article class="card" data-reveal style="--d: {{ forloop.index0 | modulo: 3 | times: 120 }}ms">
        <a href="{{ article.url }}" class="card__media" tabindex="-1" aria-hidden="true">
          {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 960px) 33vw, 50vw', alt: article.title }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
        </a>
        <div class="card__body">
          <span class="eyebrow">{{ article.published_at | date: '%b %d, %Y' }}</span>
          <a href="{{ article.url }}" class="card__title">{{ article.title }}</a>
          <p class="card__price">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </div>
      </article>
    {%- endfor -%}
  </div>
  {% render 'pagination', paginate: paginate %}
</section>
{%- endpaginate -%}
{% schema %}
{"name":"Blog","settings":[]}
{% endschema %}
