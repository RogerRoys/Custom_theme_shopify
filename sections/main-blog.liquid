<div class="page-section">
  <div class="page-width">
    <div class="section-heading">
      <h1 class="section-heading__title">{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by 12 -%}
      <ul class="product-grid" style="margin-top: 40px;">
        {%- for article in blog.articles -%}
          <li>
            <a href="{{ article.url }}" class="product-card">
              <div class="product-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 600 | image_tag: alt: article.image.alt }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">{{ article.title }}</h3>
                <p class="product-card__price">{{ article.published_at | date: '%B %d, %Y' }}</p>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="current">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
