{% comment %}
  Momemade "The Mom Standard" — dark centered founder quote.
{% endcomment %}

<section class="momemade-quote">
  {%- if section.settings.eyebrow != blank -%}
    <p class="momemade-quote__eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <blockquote class="momemade-quote__quote">{{ section.settings.quote }}</blockquote>
  {%- if section.settings.attribution != blank -%}
    <p class="momemade-quote__attribution">{{ section.settings.attribution }}</p>
  {%- endif -%}
</section>

{% style %}
  .momemade-quote {
    background: #090b00;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 96px 80px;
  }

  .momemade-quote__eyebrow {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #a0dbb3;
    margin: 0 0 24px;
  }

  .momemade-quote__quote {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: clamp(40px, 3.7vw, 56px);
    line-height: 1.1;
    letter-spacing: -1px;
    color: #f5dbdf;
    max-width: 900px;
    margin: 0 0 24px;
  }

  .momemade-quote__attribution {
    font-family: var(--momemade-font-family, 'Century Gothic', 'Poppins', sans-serif);
    font-weight: 700;
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #a0dbb3;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .momemade-quote {
      padding: 72px 40px;
    }

    .momemade-quote__quote {
      font-size: 56px;
      line-height: 60px;
      max-width: 680px;
    }

    .momemade-quote__eyebrow,
    .momemade-quote__attribution {
      font-size: 13px;
    }
  }

  @media screen and (max-width: 749px) {
    .momemade-quote {
      padding: 56px 20px;
    }

    .momemade-quote__quote {
      font-size: 48px;
      line-height: 56px;
      letter-spacing: -0.5px;
    }

    .momemade-quote__eyebrow,
    .momemade-quote__attribution {
      font-size: 11px;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Momemade quote",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Mom Standard"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "“If I wouldn’t give it to my own dog, I don’t make it.”"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "— Michele, Founder · Momemade · Hudson Valley, NY"
    }
  ],
  "presets": [
    {
      "name": "Momemade quote"
    }
  ]
}
{% endschema %}
