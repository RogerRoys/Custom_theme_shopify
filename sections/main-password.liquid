<section class="password">
  <img src="{{ 'momemade-logo-footer.svg' | asset_url }}" alt="{{ shop.name }}" width="356" height="77">
  <h1 class="h2">{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}<p class="body">{{ shop.password_message }}</p>{%- endif -%}
  {% render 'newsletter-form', form_id: 'PasswordNewsletter', note: section.settings.note %}
  <details>
    <summary class="eyebrow">Enter with password</summary>
    {%- form 'storefront_password', class: 'nl-form' -%}
      <input type="password" name="password" placeholder="Password" aria-label="Password" autocomplete="current-password">
      <button class="btn" type="submit">Enter</button>
      {%- if form.errors -%}<p class="nl-note nl-note--err">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </details>
</section>
{% schema %}
{"name":"Password","settings":[{"type":"text","id":"heading","label":"Heading","default":"Something good is baking."},{"type":"text","id":"note","label":"Note","default":"Be first to know when we open."}]}
{% endschema %}
