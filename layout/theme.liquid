<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_ink }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{%- endif -%}
  <title>{{ page_title }}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;700&family=Questrial&display=swap" rel="stylesheet">
  {% render 'css-variables' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script>
    window.Momemade = {
      routes: {
        root: {{ routes.root_url | json }},
        cart_url: {{ routes.cart_url | json }},
        cart_add_url: {{ routes.cart_add_url | json }},
        cart_change_url: {{ routes.cart_change_url | json }},
        predictive_search_url: {{ routes.predictive_search_url | json }}
      },
      cartType: {{ settings.cart_type | json }},
      moneyFormat: {{ shop.money_format | json }}
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% sections 'header-group' %}
  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {%- if settings.cart_type == 'drawer' -%}{% section 'cart-drawer' %}{%- endif -%}
  {% render 'search-overlay' %}
  <div class="toast" id="Toast" role="status" aria-live="polite"></div>
</body>
</html>
