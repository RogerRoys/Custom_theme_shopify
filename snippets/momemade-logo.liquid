{% comment %}
  Text-based fallback wordmark used when no logo image is uploaded.
  Mirrors the Figma logo: "M(paw)MEMADE" in mint green with a tagline underneath.
{% endcomment %}
<span class="momemade-logo" aria-hidden="true">
  <span class="momemade-logo__word">M<span class="momemade-logo__paw">{% render 'momemade-icons', name: 'paw' %}</span>MEMADE</span>
  <span class="momemade-logo__tagline">Dog goods. Mom approved.</span>
</span>
<span class="visually-hidden">{{ shop.name }}</span>
