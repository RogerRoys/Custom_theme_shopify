{%- assign d = i | modulo: 4 | times: 100 -%}
<article class="card" data-reveal style="--d: {{ d }}ms">
  <a href="{{ product.url }}" class="card__media" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 960px) 33vw, 50vw', alt: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </a>
  <div class="card__body">
    <a href="{{ product.url }}" class="card__title">{{ product.title }}</a>
    <span class="card__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</span>
    {%- if product.has_only_default_variant and product.available -%}
      {%- form 'product', product, class: 'card__form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button class="btn" type="submit">Add to bag</button>
      {%- endform -%}
    {%- else -%}
      <a class="btn" href="{{ product.url }}">{% if product.available %}Choose options{% else %}Sold out{% endif %}</a>
    {%- endif -%}
  </div>
</article>
