<div class="line">
  <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: class: 'line__img', loading: 'lazy', alt: item.product.title }}{%- else -%}<span class="line__img"></span>{%- endif -%}
  </a>
  <div class="line__info">
    <div class="line__row"><a href="{{ item.url }}">{{ item.product.title }}</a><span>{{ item.final_line_price | money }}</span></div>
    {%- unless item.product.has_only_default_variant -%}<span class="line__sub">{{ item.variant.title }}</span>{%- endunless -%}
    {%- for prop in item.properties -%}
      {%- assign first_char = prop.first | slice: 0 -%}
      {%- unless prop.last == blank or first_char == '_' -%}<span class="line__sub">{{ prop.first }}: {{ prop.last }}</span>{%- endunless -%}
    {%- endfor -%}
    {%- for discount in item.line_level_discount_allocations -%}<span class="line__sub">{{ discount.discount_application.title }} (−{{ discount.amount | money }})</span>{%- endfor -%}
    <div class="line__ctl">
      <div class="qty">
        <button type="button" data-line="{{ index }}" data-line-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">−</button>
        <span aria-label="Quantity">{{ item.quantity }}</span>
        <button type="button" data-line="{{ index }}" data-line-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">+</button>
      </div>
      <button type="button" class="link-btn" data-line="{{ index }}" data-line-qty="0">Remove</button>
    </div>
  </div>
</div>
