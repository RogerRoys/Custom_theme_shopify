{% comment %}
  Inline SVG icons recreated from the Figma design (proxy-safe, no external assets).
  Usage: {% render 'momemade-icons', name: 'search' %}
{% endcomment %}
{%- case name -%}
  {%- when 'search' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="7.2" stroke="currentColor" stroke-width="2"/>
      <path d="M16.4 16.4L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  {%- when 'bag' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M4.7 6.6h14.6l-.75 12.1a2.6 2.6 0 0 1-2.6 2.4H8.05a2.6 2.6 0 0 1-2.6-2.4L4.7 6.6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
      <path d="M8.7 9.3a3.3 3.3 0 0 0 6.6 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  {%- when 'user' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <circle cx="12" cy="7.5" r="3.8" stroke="currentColor" stroke-width="2"/>
      <path d="M4.5 20.5v-1.2a4.3 4.3 0 0 1 4.3-4.3h6.4a4.3 4.3 0 0 1 4.3 4.3v1.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  {%- when 'hamburger' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  {%- when 'close' -%}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  {%- when 'paw' -%}
    <svg viewBox="0 0 100 100" fill="currentColor" aria-hidden="true" focusable="false">
      <ellipse cx="50" cy="63" rx="24" ry="20"/>
      <ellipse cx="24" cy="38" rx="10" ry="13" transform="rotate(-20 24 38)"/>
      <ellipse cx="42" cy="24" rx="10" ry="13" transform="rotate(-6 42 24)"/>
      <ellipse cx="62" cy="25" rx="10" ry="13" transform="rotate(8 62 25)"/>
      <ellipse cx="79" cy="41" rx="10" ry="13" transform="rotate(24 79 41)"/>
    </svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 85 84" fill="none" aria-hidden="true" focusable="false">
      <path d="M10 46C22 34 36 20 47 6" stroke="currentColor" stroke-width="7.5" stroke-linecap="round"/>
      <path d="M28 53C45 47 62 43 80 40" stroke="currentColor" stroke-width="7.5" stroke-linecap="round"/>
      <path d="M30 72C43 68 57 64 70 61" stroke="currentColor" stroke-width="7.5" stroke-linecap="round"/>
    </svg>
  {%- when 'badge-flower' -%}
    <svg viewBox="0 0 154 154" fill="currentColor" aria-hidden="true" focusable="false">
      <circle cx="77" cy="77" r="44"/>
      <circle cx="77" cy="26" r="22"/>
      <circle cx="77" cy="128" r="22"/>
      <circle cx="26" cy="77" r="22"/>
      <circle cx="128" cy="77" r="22"/>
      <circle cx="41" cy="41" r="22"/>
      <circle cx="113" cy="41" r="22"/>
      <circle cx="41" cy="113" r="22"/>
      <circle cx="113" cy="113" r="22"/>
    </svg>
{%- endcase -%}
