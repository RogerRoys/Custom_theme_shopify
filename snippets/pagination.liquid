{%- if paginate.pages > 1 -%}
  {%- assign cp = paginate.current_page | append: '' -%}
  <nav class="pagination" aria-label="Pagination">
    {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>{%- endif -%}
    {%- for part in paginate.parts -%}
      {%- assign pt = part.title | append: '' -%}
      {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif pt == cp -%}<span class="current" aria-current="page">{{ part.title }}</span>
      {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">›</a>{%- endif -%}
  </nav>
{%- endif -%}
