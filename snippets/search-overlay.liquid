<div class="overlay" data-overlay="search" aria-hidden="true">
  <div class="overlay__scrim" data-close="search"></div>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-bar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="8.5"/><path d="M17 17l5 5"/></svg>
      <input type="search" name="q" placeholder="{{ settings.search_placeholder | escape }}" autocomplete="off" data-autofocus aria-label="Search">
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="icon-btn" data-close="search" aria-label="Close search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </form>
    {%- assign terms = settings.search_terms | split: ',' -%}
    {%- if terms.size > 0 -%}
      <div class="ps-block" data-ps-chips>
        <span class="eyebrow ps-label">Popular searches</span>
        <div class="chips">
          {%- for t in terms -%}{%- assign tt = t | strip -%}<a class="chip" href="{{ routes.search_url }}?q={{ tt | url_encode }}" data-chip="{{ tt | escape }}">{{ tt | escape }}</a>{%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    <div data-ps-results></div>
  </div>
</div>
